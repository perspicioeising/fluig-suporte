# Supabase (valores públicos, seguros para o navegador)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor (NUNCA usar prefixo NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Opcional: modelo do assistente (padrão: claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Chave de 32 bytes (64 caracteres hex ou base64) para cifrar credenciais dos ambientes Fluig.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
